# WordPress (required)
WP_URL=https://your-site.com
WP_USER=your_wp_user
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# AI: completely free local mode by default.
# local = built-in local NLP engine; ollama = your own PC/local server.
AI_PROVIDER=local
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
LOCAL_AI_LANGUAGE=ur
AUTHOR_NAME=Hafiz Muhammad Meelad Raza Attari\n\n# Revenue / conversion (empty contact URL means no service CTA)\nSERVICE_CONTACT_URL=\nENABLE_CONVERSION_OPTIMIZATION=true

# Publishing safety
POST_STATUS=draft
POSTS_PER_RUN=1
MAX_PUBLISH_RETRIES=3
REQUEST_TIMEOUT=60

# Content quality
CONTENT_TEMPERATURE=0.6
CONTENT_SIMILARITY_MAX=0.35
CONTENT_REWRITE_ATTEMPTS=2
CONTENT_SOURCE_URLS=

# Optional runtime aliases
AUTOSCRIPT_WP_URL=
AUTOSCRIPT_WP_USER=
AUTOSCRIPT_WP_APP_PASSWORD=
AUTOSCRIPT_LOCAL_AI_MODEL=

# SaaS/Auth (only needed when running the SaaS API)
DATABASE_URL=sqlite:///./saas.db
JWT_SECRET_KEY=CHANGE_THIS_IN_DEPLOYMENT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_MINUTES=43200
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_FRONTEND_SUCCESS_URL=
AUTH_BASE_URL=
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFY_EXPIRE_MINUTES=1440

# Safety: refresh reports are read-only unless explicitly enabled.
ALLOW_AUTOMATIC_REFRESH=false
UPDATE_LOOP=0
MIN_REFRESH_IMPRESSIONS=50
MAX_REFRESH_POSITION=30
MAX_REFRESH_PLANS=10
